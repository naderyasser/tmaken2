# Default App Configuration (fallback)
NEXT_PUBLIC_APP_NAME=Tamkeen
NEXT_PUBLIC_APP_VERSION=2.0.0

# Environment
NODE_ENV=production

# Optional: For development
# NEXT_PUBLIC_FRAPPE_URL=https://fayez.base.meena.sa

# dev/demo only — opens a session for site_config walkthrough_autologin_user
# instead of requiring /login (see middleware.ts). Leave unset in real
# deployments; set to '1' only for a dev/demo clone.
# NEXT_PUBLIC_WALKTHROUGH_AUTOLOGIN=1

# Storefront buyer-login (reviews write form). Off by default: visitors see read-only
# reviews + rating, no "أضف تقييمك" form. Set to 'true' (then restart :3000) to re-enable
# once a storefront buyer-login exists. Runtime env — no rebuild needed to flip.
ENABLE_BUYER_LOGIN=false

# Phone-OTP on the /post wizard. Default OFF (no SMS provider is wired): the OTP step is
# skipped, the phone is collected as contact info only, and new listings go to the team's
# review inbox (Pending License) instead of auto-publishing. The flag lives on the FRAPPE
# BACKEND (single source of truth — the storefront reads it at runtime via
# aqar_public_api.guest_post_config, so no frontend rebuild is needed):
#   set ENABLE_PHONE_OTP=1 in the backend environment, OR "enable_phone_otp": 1 in
#   sites/<site>/site_config.json, then: supervisorctl restart 'frappe-dev-web:*'
# Re-enabling restores the full flow: OTP verify + auto-publish gate (the 123456 test code
# stays dead unless Base Meena Settings.otp_test_mode is explicitly turned on for dev).
# ENABLE_PHONE_OTP=0
